{
  "name": "lazarusnet",
  "version": "0.1.0",
  "private": true,
  "description": "Lazarus Net — community-owned compute on Robinhood Chain. Compute belongs to the people.",
  "scripts": {
    "dev": "next dev -p 10200",
    "build": "prisma generate && next build",
    "start": "next start -p 10200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "node scripts/with-env.mjs prisma db push",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "db:local": "node scripts/dev-db.mjs",
    "brand": "node scripts/make-brand.mjs",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "shot": "node scripts/shot.mjs",
    "deploy": "node scripts/deploy-vercel.mjs",
    "compile:treasury": "node scripts/compile-treasury.mjs",
    "treasury:ca": "node scripts/set-treasury-ca.mjs",
    "token:ca": "node scripts/set-token-ca.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.475.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "viem": "2.56.3",
    "wagmi": "2.19.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "sharp": "^0.33.5",
    "solc": "^0.8.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
