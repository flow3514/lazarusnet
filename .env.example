# ─── Database (PostgreSQL: Neon, Supabase, or `npm run db:local`) ────────────
DATABASE_URL=

# ─── Robinhood Chain (EVM). Leave blank until you have the real values. ──────
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# ─── Contracts. Blank = "not configured" states in the UI (never faked). ──────
NEXT_PUBLIC_TOKEN_CONTRACT=
NEXT_PUBLIC_TREASURY_CONTRACT=

# ─── GPU / inference provider (server-only, never sent to the browser) ───────
# GPU_PROVIDER: openai-compatible | ollama | mock (mock only outside production)
GPU_PROVIDER=
GPU_PROVIDER_API_KEY=
GPU_PROVIDER_ENDPOINT=

# ─── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# ─── Admin (comma-separated checksummed wallet addresses) ────────────────────
ADMIN_WALLETS=

# ─── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:10200
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
